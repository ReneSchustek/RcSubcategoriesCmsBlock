{
  "name": "rc/subcategories-cms-block",
  "description": "Shopware 6 Plugin for displaying subcategories in CMS blocks",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "version": "1.1.4",
  "authors": [
    {
      "name": "Ruhrcoder (René Schustek)",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "shopware/core": "~6.7.0 || ~6.8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "extra": {
    "shopware-plugin-class": "Ruhrcoder\\RcSubcategoriesCmsBlock\\RcSubcategoriesCmsBlock",
    "label": {
      "de-DE": "Unterkategorien CMS Block",
      "en-GB": "Subcategories CMS Block"
    },
    "description": {
      "de-DE": "Erstellt einen CMS-Block zur Anzeige von Unterkategorien",
      "en-GB": "Creates a CMS block to display subcategories"
    },
    "manufacturerLink": {
      "de-DE": "https://ruhrcoder.de",
      "en-GB": "https://ruhrcoder.de"
    },
    "supportLink": {
      "de-DE": "https://ruhrcoder.de",
      "en-GB": "https://ruhrcoder.de"
    }
  },
  "autoload": {
    "psr-4": {
      "Ruhrcoder\\RcSubcategoriesCmsBlock\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ruhrcoder\\RcSubcategoriesCmsBlock\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
    "cs-fix": "vendor/bin/php-cs-fixer fix",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "quality": [
      "@cs-check",
      "@phpstan",
      "@test"
    ]
  }
}
