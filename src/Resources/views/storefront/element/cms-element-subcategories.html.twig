{% block element_subcategories %}
    {# Farben aus dem Element. Nur Hex- und rgb()-Werte werden übernommen; was anderes im Feld steht,
       fällt weg und die Theme-Farbe gilt. Das hält Fremdes aus dem style-Attribut heraus. #}
    {% set colorPattern = '/^(#[0-9a-fA-F]{3,8}|rgba?\\([0-9.,%\\s]+\\))$/' %}
    {% set colorStyle = '' %}
    {% for configKey, cssVar in { textColor: '--rc-sub-text', borderColor: '--rc-sub-border', backgroundColor: '--rc-sub-bg' } %}
        {% set colorValue = element.config[configKey].value ?? '' %}
        {% if colorValue is not empty and colorValue matches colorPattern %}
            {% set colorStyle = colorStyle ~ cssVar ~ ': ' ~ colorValue ~ '; ' %}
        {% endif %}
    {% endfor %}
    <div class="cms-element-subcategories"{% if colorStyle %} style="{{ colorStyle|trim }}"{% endif %}>
        {% set elementData = element.data %}

        {% if elementData and elementData.subcategories|length > 0 %}
            {% set config = element.config %}
            {% set displayMode = config.displayMode.value|default('grid') %}
            {% set columnsPerRow = config.columnsPerRow.value|default(4) %}
            {# `?? true` statt `|default(true)`: der default-Filter greift bei JEDEM leeren Wert — auch bei
               `false` -> ein ausgeschalteter Schalter würde fälschlich wieder auf true fallen. Null-Coalescing
               fällt nur bei null/undefined zurück und erhält ein bewusstes `false`. #}
            {% set showCategoryImage = config.showCategoryImage.value ?? true %}
            {% set showCategoryName = config.showCategoryName.value ?? true %}

            <div class="subcategories-container subcategories-container--{{ displayMode }}">
                {% if displayMode == 'grid' %}
                    <div class="subcategories-grid"
                         style="--columns: {{ columnsPerRow }};">
                        {% for category in elementData.subcategories %}
                            {% block subcategories_grid_item %}
                                <div class="subcategory-item subcategory-item--grid">
                                    <a href="{{ seoUrl('frontend.navigation.page', { 'navigationId': category.id }) }}"
                                       class="subcategory-link">

                                        {% if showCategoryImage %}
                                            {% block subcategories_grid_item_image %}
                                                <div class="subcategory-image">
                                                    {% if category.media %}
                                                        <img src="{{ category.media|sw_encode_media_url }}"
                                                             alt="{{ showCategoryName ? '' : category.translated.name }}"
                                                             class="subcategory-image-element"
                                                             loading="lazy">
                                                    {% else %}
                                                        <div class="subcategory-image-placeholder">
                                                            {% sw_icon 'folder' %}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            {% endblock %}
                                        {% endif %}

                                        {% if showCategoryName %}
                                            {% block subcategories_grid_item_name %}
                                                <div class="subcategory-name">
                                                    {{ category.translated.name }}
                                                </div>
                                            {% endblock %}
                                        {% endif %}

                                        {% if not showCategoryImage and not showCategoryName %}
                                            {% block subcategories_grid_item_sr_name %}
                                                {# Bild UND Name aus: der Link braucht trotzdem einen
                                                   zugänglichen Namen (WCAG 2.4.4 / BFSG). #}
                                                <span class="visually-hidden">{{ category.translated.name }}</span>
                                            {% endblock %}
                                        {% endif %}
                                    </a>
                                </div>
                            {% endblock %}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="subcategories-list">
                        {% for category in elementData.subcategories %}
                            {% block subcategories_list_item %}
                                <div class="subcategory-item subcategory-item--list">
                                    <a href="{{ seoUrl('frontend.navigation.page', { 'navigationId': category.id }) }}"
                                       class="subcategory-link subcategory-link--list">

                                        {% if showCategoryImage %}
                                            {% block subcategories_list_item_image %}
                                                <div class="subcategory-image subcategory-image--list">
                                                    {% if category.media %}
                                                        <img src="{{ category.media|sw_encode_media_url }}"
                                                             alt="{{ showCategoryName ? '' : category.translated.name }}"
                                                             class="subcategory-image-element"
                                                             loading="lazy">
                                                    {% else %}
                                                        <div class="subcategory-image-placeholder">
                                                            {% sw_icon 'folder' %}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            {% endblock %}
                                        {% endif %}

                                        {% if showCategoryName %}
                                            {% block subcategories_list_item_content %}
                                                <div class="subcategory-content">
                                                    <div class="subcategory-name">
                                                        {{ category.translated.name }}
                                                    </div>
                                                </div>
                                            {% endblock %}
                                        {% endif %}

                                        {% if not showCategoryImage and not showCategoryName %}
                                            {% block subcategories_list_item_sr_name %}
                                                {# Bild UND Name aus: der Link braucht trotzdem einen
                                                   zugänglichen Namen (WCAG 2.4.4 / BFSG). #}
                                                <span class="visually-hidden">{{ category.translated.name }}</span>
                                            {% endblock %}
                                        {% endif %}
                                    </a>
                                </div>
                            {% endblock %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% else %}
            {% block subcategories_empty %}
                <div class="subcategories-empty">
                    <p>{{ "cms.subcategories.noSubcategories"|trans }}</p>
                </div>
            {% endblock %}
        {% endif %}
    </div>
{% endblock %}

{# Styles liegen in src/Resources/app/storefront/src/scss/base.scss (Theme-Build),
   bewusst nicht als Inline-CSS im Template (das würde den HTTP-Cache blocken). #}